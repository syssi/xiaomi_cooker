#!/usr/bin/env bash
# Run Home Assistant against this repo's custom_components.
set -euo pipefail
cd "$(dirname "$0")/.."

mkdir -p config

if [[ ! -f config/configuration.yaml ]]; then
    cat > config/configuration.yaml <<'YAML'
default_config:

logger:
  default: info
  logs:
    custom_components.xiaomi_miio_cooker: debug
    miio: debug

# Fill in the cooker's IP and token, then restart.
# xiaomi_miio_cooker:
#   host: 192.168.x.x
#   token: xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   model: chunmi.cooker.wy3
YAML
fi

# Symlink rather than copy so edits are picked up on restart.
mkdir -p config/custom_components
ln -sfn "$(pwd)/custom_components/xiaomi_miio_cooker" config/custom_components/xiaomi_miio_cooker

exec hass --config config --debug
