{
  "name": "xiaomi_cooker",
  "image": "mcr.microsoft.com/devcontainers/python:3-3.14-trixie",
  // Host networking so Home Assistant can reach the cooker on the LAN and so
  // http://localhost:8123 works without port juggling. Linux only.
  "runArgs": ["--network=host"],
  "postCreateCommand": "scripts/setup",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true
        }
      }
    }
  }
}
